# ===================================================
# ZWEI CHAT PREMIUM - ARQUIVO DE CONFIGURAÇÃO (.env)
# ===================================================

# ---------------------------------------------------
# 1. CREDENCIAIS META WHATSAPP CLOUD API
# ---------------------------------------------------
# ID do Número de Telefone no painel da Meta (WhatsApp > Configuração da API)
META_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# ID da Conta do WhatsApp Business (WABA ID)
META_WABA_ID=seu_waba_id_aqui

# Token de Acesso Permanente de Usuário do Sistema (System User Token)
META_ACCESS_TOKEN=seu_access_token_permanente_aqui

# Segredo do Aplicativo Meta (App Secret - Usado para validar assinatura HMAC-SHA256 dos Webhooks)
META_APP_SECRET=seu_app_secret_aqui

# Token de Verificação personalizado (Definido por você para o handshake GET /webhook)
META_VERIFY_TOKEN=sua_frase_secreta_de_verificacao_webhook

# Versão da Graph API da Meta (Recomendado: v21.0 ou superior)
META_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------
# 2. CONFIGURAÇÃO DO FIREBASE (CLIENT & ADMIN SDK)
# ---------------------------------------------------
# Credenciais do Projeto Firebase
FIREBASE_PROJECT_ID=seu_projeto_firebase_id
FIREBASE_API_KEY=sua_api_key_firebase
FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
FIREBASE_APP_ID=seu_app_id_firebase

# ---------------------------------------------------
# 3. CONFIGURAÇÕES DA APLICAÇÃO
# ---------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
