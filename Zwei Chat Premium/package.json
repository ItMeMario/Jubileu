{
  "name": "zwei-chat-premium",
  "version": "1.0.0",
  "description": "Zwei Chat Premium - Versão Corporativa com Meta WhatsApp Cloud API e Firebase",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "node scripts/env-manager.js dev && electron .",
    "start:prod": "node scripts/env-manager.js prod && electron .",
    "env:dev": "node scripts/env-manager.js dev",
    "env:prod": "node scripts/env-manager.js prod",
    "env:status": "node scripts/env-manager.js status",
    "gateway": "node cloud-gateway/server.js",
    "build:obfuscate": "node scripts/build-obfuscate.js",
    "test:webhook": "node tests/testWebhookSimulator.js",
    "test:xss": "node tests/xssSecurity.test.js",
    "test:tunnel": "node tests/tunnelWatchdogSecurity.test.js",
    "dist": "npm run build:obfuscate && electron-builder",
    "dist:win": "npm run build:obfuscate && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.3",
    "firebase": "^12.17.1",
    "sqlite3": "^5.1.7",
    "untun": "^0.2.2"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "firebase-admin": "^14.3.0",
    "javascript-obfuscator": "^5.7.0",
    "localtunnel": "^2.0.2"
  },
  "build": {
    "appId": "com.itmemario.zweichatpremium",
    "productName": "Zwei Chat Premium",
    "artifactName": "zwei-chat-premium-setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      {
        "from": "build-protected",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!build-protected/**/*",
      "!data/**/*",
      "!scratch/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!scripts/**/*",
      "!firebase-backend/**/*",
      "!serviceAccountKey*.json",
      "!firestore.rules",
      "!*.log",
      "!.git/**/*",
      "!.gitignore",
      "!*.md"
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true
    },
    "compression": "normal",
    "npmRebuild": true,
    "buildDependenciesFromSource": false
  }
}
