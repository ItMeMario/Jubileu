{
  "name": "zwei-chat",
  "version": "1.0.0",
  "description": "Versão lite e independente do bot de WhatsApp Jubileu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "firebase": "^12.17.1",
    "puppeteer": "^24.15.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^5.1.7",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.itmemario.zweichat",
    "productName": "Zwei Chat",
    "artifactName": "zwei-chat-setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!node_modules/puppeteer-core/.local-chromium/**/*",
      "!data/**/*",
      "!.wwebjs_auth/**/*",
      "!.wwebjs_cache/**/*",
      "!scratch/**/*",
      "!scripts/**/*",
      "!serviceAccountKey*.json",
      "!firestore.rules",
      "!*.log",
      "!.git/**/*",
      "!.gitignore",
      "!README.md"
    ],
    "asarUnpack": [
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/Zwei-chat-_Arte-Gimp_.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "build/Zwei-chat-_Arte-Gimp_.ico",
      "deleteAppDataOnUninstall": false,
      "allowElevation": true
    },
    "compression": "normal",
    "npmRebuild": true,
    "buildDependenciesFromSource": false
  }
}
