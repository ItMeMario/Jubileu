{
  "name": "whatsapp-bot-jubileu",
  "version": "1.0.0",
  "description": "Bot de WhatsApp com interface Electron",
  "author": "ItMeMario",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "enquirer": "^2.4.1",
    "puppeteer": "^24.15.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^5.1.7",
    "string-similarity": "^4.0.4",
    "whatsapp-web.js": "^1.34.2"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.itmemario.jubileubot",
    "productName": "Jubileu Bot",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!node_modules/puppeteer-core/.local-chromium/**/*",
      "!data/**/*",
      "!.wwebjs_auth/**/*",
      "!*.log",
      "!.git/**/*",
      "!.gitignore",
      "!README.md"
    ],
    "asarUnpack": [
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/sqlite3/**/*",
      "services/**/*",
      "config/**/*",
      "utils/**/*",
      "main/**/*",
      "handlers/**/*",
      "controllers/**/*",
      "client/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "allowElevation": true
    },
    "compression": "normal",
    "npmRebuild": true,
    "buildDependenciesFromSource": false
  }
}
